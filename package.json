{
    "name": "heidelbergsfinest",
    "version": "0.0.1",
    "description": "Heidelbergs Finest Mountainbike Trails Tourenbuch",
    "scripts": {
        "clean": "rm -rf _site",
        "build:images": "ELEVENTY_ENV=production eleventy",
        "build:win": "npm-run-all build:eleventy build:sass build:rollup",
        "build": "npm-run-all clean build:sass build:eleventy build:rollup",
        "build:github": "npm-run-all clean build:eleventy:pathPrefix build:sass build:rollup",
        "build:eleventy": "ELEVENTY_ENV=production eleventy",
        "build:eleventy:pathPrefix": "ELEVENTY_ENV=production eleventy",
        "build:sass": "sass src/assets/css/index.scss _site/assets/css/index.css --style compressed",
        "build:rollup": "NODE_ENV=production rollup -c",
        "build:fast": "npm-run-all build:eleventy:fast build:sass build:rollup",
        "build:eleventy:fast": "ELEVENTY_ENV=production ELEVENTY_SKIP_IMAGES=true eleventy",
        "dev": "npm-run-all clean -p dev:*",
        "dev:fast": "npm-run-all -p dev:eleventy:fast dev:sass dev:rollup",
        "dev:sass": "sass --watch src/assets/css/index.scss _site/assets/css/index.css --style compressed",
        "dev:eleventy": "ELEVENTY_ENV=development eleventy --serve --port=3000",
        "dev:eleventy:fast": "ELEVENTY_ENV=development ELEVENTY_SKIP_IMAGES=true eleventy --serve --port=3000",
        "dev:rollup": "rollup -c -w",
        "debug": "DEBUG=* eleventy"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Heidelbergs-Finest/heidelbergs-finest.github.io"
    },
    "author": {
        "name": "HDF",
        "email": "HDF+markbangert@gmail.com",
        "url": "https://www.heidelbergs-finest.de/"
    },
    "license": "MIT",
    "devDependencies": {
        "@11ty/eleventy": "^2.0.1",
        "@11ty/eleventy-img": "^3.0.0",
        "@11ty/eleventy-navigation": "^0.3.5",
        "@11ty/eleventy-plugin-rss": "^1.2.0",
        "@11ty/eleventy-plugin-syntaxhighlight": "^3.1.0",
        "@rollup/plugin-node-resolve": "^15.3.0",
        "autoprefixer": "^10.4.20",
        "clean-css": "^5.3.3",
        "glob-promise": "^6.0.4",
        "image-size": "^1.1.1",
        "luxon": "^3.5.0",
        "markdown-it": "^14.1.0",
        "markdown-it-anchor": "^8.6.0",
        "markdown-it-container": "^4.0.0",
        "nanoid": "^5.0.7",
        "npm-run-all": "^4.1.5",
        "photoswipe": "^5.4.4",
        "rollup": "^2.79.1",
        "rollup-plugin-terser": "^7.0.2",
        "sass": "^1.78.0"
    },
    "dependencies": {
        "animejs": "^4.1.0"
    }
}
